#!/usr/bin/env python3
"""
claude-relay
------------
Use several Claude subscriptions as one, without losing your sessions.

  claude-relay run [claude args]   Start Claude Code in the terminal. When the current
                                   account reaches its usage threshold (or hits its limit),
                                   claude-relay switches to the next account and resumes
                                   the same session automatically.
  claude-relay accounts ...        Add, list and remove accounts (one long-lived token each,
                                   from `claude setup-token`).
  claude-relay desktop [options]   After switching accounts in Claude Desktop (macOS):
                                   bring your Code-tab sessions to the new account and
                                   restart Claude Desktop's helpers on your SSH hosts.
  claude-relay remote ...          Manage the SSH hosts used by `desktop` and `watch`.
  claude-relay watch               Watch for usage limits on this Mac and the SSH hosts: mark the
                                   account exhausted everywhere, tell you to switch Claude
                                   Desktop, then move the sessions once you have.
  claude-relay service ...         Run `watch` in the background (launchd agent, macOS).
  claude-relay config ...          Show or change settings (threshold, continue prompt...).

The `desktop` command is a macOS port of restore-code-tab-sessions.ps1 from
https://github.com/sahol3/claude-code-session-restorer (MIT).

Unofficial tool. It relies on documented Claude Code features (CLAUDE_CODE_OAUTH_TOKEN,
status line rate_limits, hooks, --resume) and, for `desktop`, on Claude Desktop files whose
format was worked out by observation and may change in any update.
"""
import argparse
import getpass
import json
import os
import plistlib
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

__version__ = "2.2.6"

PROG = "claude-relay"
HOME = Path.home()
IS_MAC = sys.platform == "darwin"

# Claude Code / Claude Desktop locations
DEFAULT_PROJECTS = HOME / ".claude" / "projects"
DEFAULT_CARDS = HOME / "Library" / "Application Support" / "Claude" / "claude-code-sessions"
CLAUDE_JSON = HOME / ".claude.json"
APP_NAME = "Claude"
DESKTOP_CONFIG_FILES = ("config.json", "claude_desktop_config.json")

# claude-relay's own files
RELAY_HOME = Path(os.environ.get("CLAUDE_RELAY_HOME") or
                  Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "claude-relay")
CONFIG_FILE = RELAY_HOME / "config.json"
STATE_FILE = RELAY_HOME / "state.json"
LOCK_FILE = RELAY_HOME / ".lock"
RUNS_DIR = RELAY_HOME / "runs"
TOKENS_DIR = RELAY_HOME / "tokens"
RESUME_FILE = RELAY_HOME / "resume.json"
WATCH_LOG = RELAY_HOME / "watch.log"
KEYCHAIN_SERVICE = "claude-relay"
LAUNCH_LABEL = "io.github.guedesdiogo.claude-relay"

DEFAULT_CONFIG = {
    "accounts": [],               # [{"name": "work", "store": "keychain"|"file"}]
    "threshold": 95,              # switch at this % of the 5-hour or weekly window; 100 = only on the limit
    "continue_prompt": "Continue exactly where you left off.",
    "cooldown_minutes": 30,       # how long to skip an account that hit its limit when the reset time is unknown
    "claude_bin": "claude",
    "remotes": [],                # SSH hosts where Claude Desktop runs remote sessions
    "notify": True,               # macOS notification when an account switch happens
    "follow_desktop": True,       # `run` uses the account Claude Desktop uses (published by `watch`)
    "resume_prompt": ("This session stopped when its Claude account hit its usage limit, and claude-relay "
                      "moved it to another account. Background tasks and notifications from that time may "
                      "be lost, so check the real state first. Continue exactly where you left off."),
}

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9._~+/=-]{20,}$")
TOKEN_CHARS_RE = re.compile(r"^[A-Za-z0-9._~+/=-]+$")
MIN_TOKEN_LENGTH = 100  # `claude setup-token` prints 108 characters; fewer means part of it

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
COLORS = {"gray": "90", "white": "97", "cyan": "36", "green": "32", "yellow": "33", "red": "31"}


def say(msg, color="gray", err=False):
    stream = sys.stderr if err else sys.stdout
    color_ok = stream.isatty() and os.environ.get("NO_COLOR") is None
    stream.write(f"\033[{COLORS[color]}m{msg}\033[0m\n" if color_ok else f"{msg}\n")
    stream.flush()


def die(msg, code=1):
    say(msg, "red", err=True)
    sys.exit(code)


# ---------------------------------------------------------------------------
# Small file helpers
# ---------------------------------------------------------------------------
def load_json(path):
    try:
        with open(path, "r", encoding="utf-8-sig") as f:
            return json.load(f)
    except Exception:
        return None


def write_json(path, data, mode=0o600):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


class Locked:
    """Process-wide lock around state updates (several terminals may run claude-relay at once)."""

    def __enter__(self):
        RELAY_HOME.mkdir(parents=True, exist_ok=True)
        self.fh = open(LOCK_FILE, "a")
        try:
            import fcntl
            fcntl.flock(self.fh, fcntl.LOCK_EX)
        except Exception:
            pass
        return self

    def __exit__(self, *exc):
        try:
            import fcntl
            fcntl.flock(self.fh, fcntl.LOCK_UN)
        except Exception:
            pass
        self.fh.close()


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    data = load_json(CONFIG_FILE)
    if isinstance(data, dict):
        cfg.update(data)
    cfg["accounts"] = [a for a in cfg.get("accounts") or [] if isinstance(a, dict) and a.get("name")]
    return cfg


def save_config(cfg):
    write_json(CONFIG_FILE, cfg)


def load_state():
    st = load_json(STATE_FILE)
    st = st if isinstance(st, dict) else {}
    st.setdefault("active", None)
    st.setdefault("usage", {})
    st.setdefault("exhausted", {})
    st.setdefault("cleared", {})  # {name: epoch}: when `reset`, `use` or `accounts add` last cleared its mark
    return st


def update_state(fn):
    with Locked():
        st = load_state()
        fn(st)
        write_json(STATE_FILE, st)
        return st


def run_file(run_id):
    return RUNS_DIR / f"{run_id}.json"


def load_run(run_id):
    data = load_json(run_file(run_id))
    return data if isinstance(data, dict) else {}


def update_run(run_id, fn):
    with Locked():
        data = load_run(run_id)
        fn(data)
        write_json(run_file(run_id), data)
        return data


# ---------------------------------------------------------------------------
# Token storage: macOS Keychain or a 0600 file
# ---------------------------------------------------------------------------
def default_store():
    forced = os.environ.get("CLAUDE_RELAY_TOKEN_STORE")
    if forced in ("keychain", "file"):
        return forced
    return "keychain" if IS_MAC and shutil.which("security") else "file"


def token_set(name, token, store):
    if store == "keychain":
        # `security -i` reads the command from stdin, so the token never appears in `ps`.
        cmd = f'add-generic-password -U -s "{KEYCHAIN_SERVICE}" -a "{name}" -w "{token}"\n'
        r = subprocess.run(["security", "-i"], input=cmd, capture_output=True, text=True)
        if r.returncode != 0 or "error" in (r.stderr or "").lower():
            die(f"Could not save the token in the macOS Keychain: {(r.stderr or r.stdout).strip()}")
    else:
        TOKENS_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(TOKENS_DIR, 0o700)
        path = TOKENS_DIR / name
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(token + "\n")
        os.chmod(path, 0o600)


def token_get(name, store):
    if store == "keychain":
        r = subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name, "-w"],
                           capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else None
    path = TOKENS_DIR / name
    try:
        return path.read_text().strip() or None
    except Exception:
        return None


def token_delete(name, store):
    if store == "keychain":
        subprocess.run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name],
                       capture_output=True, text=True)
    else:
        try:
            (TOKENS_DIR / name).unlink()
        except FileNotFoundError:
            pass


def parse_token_text(text):
    """Accept a raw token or a line like `export CLAUDE_CODE_OAUTH_TOKEN=...`. A token copied from a
    narrow terminal arrives broken over lines: the lines after `sk-ant-...` that hold only token
    characters are joined back to it, without the spaces around them."""
    lines = (text or "").splitlines()
    for i, line in enumerate(lines):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.search(r"CLAUDE_CODE_OAUTH_TOKEN\s*=\s*['\"]?([^'\"\s]+)", line)
        candidate = m.group(1) if m else line
        if candidate.startswith("sk-ant-"):
            for more in lines[i + 1:]:
                more = more.strip().rstrip("'\"")  # the closing quote of an `export` line
                if not TOKEN_CHARS_RE.match(more):
                    break
                candidate += more
        if TOKEN_RE.match(candidate):
            return candidate
    return None


PASTE_WAIT = 0.2  # seconds: the other lines of one paste arrive well within this


def read_hidden(prompt):
    """Read a pasted token from the terminal with echo off. getpass returns only the first line of
    a token broken over lines, and leaves the rest for the shell, which runs it as commands. Here
    the lines that follow within PASTE_WAIT are read too, still without echo, and what arrives after
    that is discarded."""
    try:
        import select
        import termios
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except (ImportError, OSError):
        return getpass.getpass(prompt)
    chunks = []
    try:
        old = termios.tcgetattr(fd)
        new = termios.tcgetattr(fd)
        new[3] &= ~termios.ECHO
        termios.tcsetattr(fd, termios.TCSAFLUSH, new)
        try:
            os.write(fd, prompt.encode())
            chunks.append(os.read(fd, 4096))  # a terminal hands over one line per read
            while chunks[-1] and select.select([fd], [], [], PASTE_WAIT)[0]:
                chunks.append(os.read(fd, 4096))
        finally:
            termios.tcsetattr(fd, termios.TCSAFLUSH, old)
            os.write(fd, b"\n")
    finally:
        os.close(fd)
    return b"".join(chunks).decode("utf-8", errors="replace")


# ---------------------------------------------------------------------------
# Account availability
# ---------------------------------------------------------------------------
WINDOWS = (("five_hour", "5h"), ("seven_day", "7d"))


def exhausted_until(mark):
    """Epoch until which an `exhausted` mark holds (older versions stored a bare number)."""
    return mark.get("until") if isinstance(mark, dict) else mark


def mark_since(mark):
    """When an `exhausted` mark was made; None for marks from versions before 2.2.2."""
    return mark.get("since") if isinstance(mark, dict) else None


def merge_marks(st, other):
    """Merge another machine's `exhausted` marks and `cleared` times into the state `st`. For each
    account the later clear wins, marks made before it are dropped on both sides (a mark without
    `since` counts as older than any clear), and among the marks left the later reset wins."""
    cleared, marks = st["cleared"], st["exhausted"]
    for name, at in (other.get("cleared") or {}).items():
        if isinstance(at, (int, float)) and at > (cleared.get(name) or 0):
            cleared[name] = at

    def stale(name, mark):
        return name in cleared and (mark_since(mark) or 0) <= cleared[name]

    for name in [n for n, m in marks.items() if stale(n, m)]:
        del marks[name]
    for name, mark in (other.get("exhausted") or {}).items():
        until = exhausted_until(mark)
        if (isinstance(until, (int, float)) and not stale(name, mark)
                and until > (exhausted_until(marks.get(name)) or 0)):
            marks[name] = mark if isinstance(mark, dict) else {"until": until, "reason": "hit its limit"}


def clear_mark(st, name):
    """Forget `name`'s exhausted mark here; `cleared` makes that win over the other machines' copies."""
    st["exhausted"].pop(name, None)
    st["cleared"][name] = time.time()


def account_block(name, state, threshold, now=None):
    """Return None if the account can be used, otherwise (reason, until_epoch_or_None)."""
    now = now or time.time()
    ex = (state.get("exhausted") or {}).get(name)
    until, why = (ex.get("until"), ex.get("reason") or "hit its limit") if isinstance(ex, dict) else (ex, "hit its limit")
    if until and until > now:
        return (why, until)
    usage = (state.get("usage") or {}).get(name) or {}
    limit = min(max(int(threshold), 1), 100)
    for key, label in WINDOWS:
        w = usage.get(key) or {}
        used, resets = w.get("used"), w.get("resets_at")
        if used is None:
            continue
        if resets and resets <= now:
            continue  # window already reset
        if used >= limit:
            return (f"{label} window at {used:.0f}%", resets)
    return None


def choose_account(cfg, state, exclude=(), prefer=None):
    names = [a["name"] for a in cfg["accounts"]]
    if not names:
        return None
    start = prefer if prefer in names else (state.get("active") if state.get("active") in names else names[0])
    i = names.index(start)
    for name in names[i:] + names[:i]:
        if name in exclude:
            continue
        if account_block(name, state, cfg["threshold"]) is None:
            return name
    return None


DESKTOP_FRESH = 600  # `watch` publishes every 30 s; an older value means it stopped (or the Mac sleeps)


def desktop_choice(cfg, state):
    """The account Claude Desktop uses (published by `watch`), when `run` follows it and can use it."""
    name = state.get("desktop")
    if time.time() - (state.get("desktop_at") or 0) > DESKTOP_FRESH:
        return None
    acc = find_account(cfg, name) if cfg.get("follow_desktop", True) else None
    if acc and account_block(name, state, cfg["threshold"]) is None and token_get(name, acc.get("store", "file")):
        return name
    return None


def fmt_time(epoch):
    if not epoch:
        return "unknown"
    return datetime.fromtimestamp(epoch).strftime("%a %d %b %H:%M")


def usage_summary(name, state):
    usage = (state.get("usage") or {}).get(name) or {}
    parts = []
    for key, label in WINDOWS:
        w = usage.get(key) or {}
        if w.get("used") is not None:
            parts.append(f"{label} {w['used']:.0f}%")
    return " · ".join(parts) if parts else "no usage seen yet"


def notify(cfg, title, text):
    if not (IS_MAC and cfg.get("notify") and not os.environ.get("CLAUDE_RELAY_NO_NOTIFY")):
        return
    script = f"display notification {json.dumps(text)} with title {json.dumps(title)}"
    try:
        subprocess.run(["osascript", "-e", script], capture_output=True, timeout=5)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# `claude-relay accounts | use | config`
# ---------------------------------------------------------------------------
def find_account(cfg, name):
    for a in cfg["accounts"]:
        if a["name"] == name:
            return a
    return None


def cmd_accounts_add(args):
    name = args.name
    if not NAME_RE.match(name):
        die("Account names may use letters, digits, '.', '_' and '-' (max 64 characters).")
    store = args.store or default_store()
    if store == "keychain" and not (IS_MAC and shutil.which("security")):
        die("The keychain store is only available on macOS. Use --store file.")
    if args.token_file:
        token = parse_token_text(Path(args.token_file).expanduser().read_text())
    elif not sys.stdin.isatty():
        token = parse_token_text(sys.stdin.read())
    else:
        say(f"Paste the long-lived token for '{name}'. Create it with `claude setup-token` while signed in", "cyan")
        say("to that account in your browser. The token is hidden while you paste.", "cyan")
        token = parse_token_text(read_hidden("Token: "))
    if not token:
        die("That does not look like a token from `claude setup-token`.")
    if not token.startswith("sk-ant-") or len(token) < MIN_TOKEN_LENGTH:
        die(f"That is not a whole token from `claude setup-token` ({len(token)} characters; a token starts with "
            f"sk-ant- and has about 108). Paste the whole token. Nothing was saved.")
    token_set(name, token, store)

    def upd(cfg):
        existing = find_account(cfg, name)
        if existing:
            existing["store"] = store
        else:
            cfg["accounts"].append({"name": name, "store": store})
        return cfg

    with Locked():
        cfg = upd(load_config())
        save_config(cfg)

    def upd_state(st):
        st["active"] = st.get("active") or name
        mark = st["exhausted"].get(name)
        if isinstance(mark, dict) and mark.get("reason") == TOKEN_REJECTED:  # a usage limit stays
            clear_mark(st, name)
    update_state(upd_state)
    say(f"Saved account '{name}' ({'macOS Keychain' if store == 'keychain' else TOKENS_DIR / name}).", "green")
    return 0


def cmd_accounts_list(args):
    cfg, state = load_config(), load_state()
    if not cfg["accounts"]:
        say(f"No accounts yet. Add one with: {PROG} accounts add <name>", "yellow")
        return 0
    thr = cfg["threshold"]
    say(f"Switch threshold: {thr}%{' (only when the limit is hit)' if thr >= 100 else ''}", "cyan")
    for a in cfg["accounts"]:
        name = a["name"]
        mark = "*" if name == state.get("active") else " "
        block = account_block(name, state, thr)
        status = "available" if block is None else f"skipped until {fmt_time(block[1])} ({block[0]})"
        has_token = token_get(name, a.get("store", "file")) is not None
        token_note = "" if has_token else "  [token missing]"
        desktop_note = f"  [Desktop {a['desktop_account']}]" if a.get("desktop_account") else ""
        say(f" {mark} {name:<16} {usage_summary(name, state):<22} {status}{token_note}{desktop_note}",
            "white" if block is None else "yellow")
    return 0


def cmd_accounts_link(args):
    """Name a Claude Desktop account, so `watch` can mark the right claude-relay account exhausted."""
    if not NAME_RE.match(args.name):
        die("Account names may use letters, digits, '.', '_' and '-' (max 64 characters).")
    with Locked():
        cfg = load_config()
        for a in cfg["accounts"]:
            if a.get("desktop_account") == args.desktop_account:
                a.pop("desktop_account")
        acc = find_account(cfg, args.name)
        if acc is None:  # Desktop-only for now; `accounts add` stores its token later
            acc = {"name": args.name, "store": default_store()}
            cfg["accounts"].append(acc)
        acc["desktop_account"] = args.desktop_account
        save_config(cfg)
    say(f"'{args.name}' is Claude Desktop account {args.desktop_account}.", "green")
    return 0


def cmd_accounts_remove(args):
    with Locked():
        cfg = load_config()
        acc = find_account(cfg, args.name)
        if not acc:
            die(f"No account named '{args.name}'.")
        cfg["accounts"] = [a for a in cfg["accounts"] if a["name"] != args.name]
        save_config(cfg)
    token_delete(args.name, acc.get("store", "file"))

    def upd(st):
        st["usage"].pop(args.name, None)
        st["exhausted"].pop(args.name, None)
        if st.get("active") == args.name:
            st["active"] = cfg["accounts"][0]["name"] if cfg["accounts"] else None
    update_state(upd)
    say(f"Removed account '{args.name}' and its token.", "green")
    return 0


def cmd_use(args):
    cfg = load_config()
    if not find_account(cfg, args.name):
        die(f"No account named '{args.name}'.")

    def upd(st):
        st["active"] = args.name
        clear_mark(st, args.name)
    st = update_state(upd)
    say(f"Active account: {args.name}", "green")
    follow = desktop_choice(cfg, st)
    if follow and follow != args.name:
        say(f"Note: `{PROG} run` follows Claude Desktop's account ({follow}). To keep {args.name}, run: "
            f"{PROG} config follow_desktop false", "yellow")
    return 0


def cmd_reset(args):
    accounts = [a["name"] for a in load_config()["accounts"]]  # a mark may be only on another machine

    def upd(st):
        names = [args.name] if args.name else accounts + list(st["usage"].keys()) + list(st["exhausted"].keys())
        for n in names:
            st["usage"].pop(n, None)
            clear_mark(st, n)
    update_state(upd)
    say("Forgot the recorded usage; accounts will be tried again.", "green")
    return 0


CONFIG_KEYS = {
    "threshold": int, "continue_prompt": str, "cooldown_minutes": int, "claude_bin": str, "notify": None,
    "follow_desktop": None, "resume_prompt": str,
}


def cmd_config(args):
    with Locked():
        cfg = load_config()
        if args.key is None:
            shown = {k: v for k, v in cfg.items() if k != "accounts"}
            shown["accounts"] = [a["name"] for a in cfg["accounts"]]
            print(json.dumps(shown, indent=2, ensure_ascii=False))
            return 0
        if args.key not in CONFIG_KEYS:
            die(f"Unknown setting '{args.key}'. Settings: {', '.join(CONFIG_KEYS)}")
        if args.value is None:
            print(cfg.get(args.key))
            return 0
        if args.key == "threshold":
            v = int(args.value)
            if not 1 <= v <= 100:
                die("threshold must be between 1 and 100 (100 = switch only when the limit is hit).")
        elif CONFIG_KEYS[args.key] is None:  # on/off settings
            v = args.value.lower() in ("1", "true", "yes", "on")
        else:
            v = CONFIG_KEYS[args.key](args.value)
        cfg[args.key] = v
        save_config(cfg)
    say(f"{args.key} = {v}", "green")
    return 0


# ---------------------------------------------------------------------------
# `claude-relay run`: the terminal wrapper
# ---------------------------------------------------------------------------
# Claude Code flags (https://code.claude.com/docs/en/cli-reference) that take a value.
VALUE_OPTS = {
    "--advisor", "--agent", "--agents", "--append-system-prompt", "--append-system-prompt-file",
    "--append-subagent-system-prompt", "--append-subagent-system-prompt-file", "--autocompact",
    "--betas", "--cloud", "--debug-file", "--effort", "--environment", "--exec", "--fallback-model",
    "--from-pr", "--input-format", "--json-schema", "--max-budget-usd", "--max-turns", "--model",
    "--name", "-n", "--output-format", "--permission-mode", "--permission-prompt-tool",
    "--permission-prompts", "--plugin-dir", "--ref", "--remote-control-session-name-prefix",
    "--setting-sources", "--settings", "--system-prompt", "--system-prompt-file",
    "--system-prompt-snapshot", "--teammate-mode", "--tools",
}
VARIADIC_OPTS = {
    "--add-dir", "--allowedTools", "--allowed-tools", "--disallowedTools", "--disallowed-tools",
    "--mcp-config", "--channels", "--plugin-url",
}
OPTIONAL_VALUE_OPTS = {"--debug", "-w", "--worktree", "--tmux", "--remote-control", "--rc"}
# Dropped when claude-relay restarts Claude on another account (it adds its own --resume).
DROP_FLAGS = {"-c", "--continue"}
DROP_WITH_OPTIONAL_VALUE = {"-r", "--resume"}
DROP_WITH_VALUE = {"--session-id"}


def split_settings_arg(argv):
    """Remove the user's --settings (we merge it into ours). Returns (argv, settings_dict)."""
    out, user = [], {}
    i = 0
    while i < len(argv):
        tok = argv[i]
        val = None
        if tok == "--settings" and i + 1 < len(argv):
            val = argv[i + 1]
            i += 2
        elif tok.startswith("--settings="):
            val = tok.split("=", 1)[1]
            i += 1
        else:
            out.append(tok)
            i += 1
            continue
        loaded = None
        try:
            loaded = json.loads(val)
        except Exception:
            loaded = load_json(Path(val).expanduser())
        if isinstance(loaded, dict):
            user = deep_merge(user, loaded)
    return out, user


def restart_args(argv):
    """Keep the user's options, drop the initial prompt and any resume/continue flags."""
    out = []
    i = 0
    n = len(argv)
    while i < n:
        tok = argv[i]
        nxt = argv[i + 1] if i + 1 < n else None
        if tok == "--":
            break  # everything after is the prompt
        if tok.startswith("--") and "=" in tok:
            if tok.split("=", 1)[0] not in (DROP_WITH_OPTIONAL_VALUE | DROP_WITH_VALUE):
                out.append(tok)
            i += 1
            continue
        if tok in DROP_FLAGS:
            i += 1
            continue
        if tok in DROP_WITH_OPTIONAL_VALUE:
            i += 2 if (nxt is not None and not nxt.startswith("-")) else 1
            continue
        if tok in DROP_WITH_VALUE:
            i += 2
            continue
        if tok in VALUE_OPTS:
            out.append(tok)
            if nxt is not None:
                out.append(nxt)
            i += 2
            continue
        if tok in VARIADIC_OPTS:
            out.append(tok)
            i += 1
            while i < n and not argv[i].startswith("-"):
                out.append(argv[i])
                i += 1
            continue
        if tok in OPTIONAL_VALUE_OPTS:
            out.append(tok)
            if nxt is not None and not nxt.startswith("-") and not re.search(r"\s", nxt):
                out.append(nxt)
                i += 2
            else:
                i += 1
            continue
        if tok.startswith("-"):
            out.append(tok)  # boolean flag
            i += 1
            continue
        i += 1  # positional: the initial prompt, already sent
    return out


def is_print_mode(argv):
    return any(t in ("-p", "--print") for t in argv)


def deep_merge(base, extra):
    out = dict(base)
    for k, v in extra.items():
        if k == "hooks" and isinstance(v, dict) and isinstance(out.get(k), dict):
            merged = {ev: list(lst) for ev, lst in out[k].items()}
            for ev, lst in v.items():
                merged.setdefault(ev, [])
                merged[ev] = merged[ev] + list(lst)
            out[k] = merged
        elif isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def self_command():
    return f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))}"


def relay_settings(user_settings):
    me = self_command()

    def hook(event):
        return [{"hooks": [{"type": "command", "command": f"{me} _hook {event}", "timeout": 30}]}]

    ours = {
        "statusLine": {"type": "command", "command": f"{me} _statusline", "padding": 0},
        "hooks": {
            "SessionStart": hook("session-start"),
            "Stop": hook("stop"),
            "StopFailure": [{"matcher": "rate_limit|billing_error|authentication_failed",
                             "hooks": [{"type": "command", "command": f"{me} _hook stop-failure", "timeout": 30}]}],
        },
    }
    return deep_merge({k: v for k, v in user_settings.items() if k != "statusLine"}, ours)


def find_user_statusline(user_settings, cwd):
    """The status line the user would see without claude-relay (highest settings level wins)."""
    if isinstance(user_settings.get("statusLine"), dict):
        return user_settings["statusLine"]
    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude").expanduser()
    for path in (Path(cwd) / ".claude" / "settings.local.json", Path(cwd) / ".claude" / "settings.json",
                 config_dir / "settings.json"):
        data = load_json(path)
        if isinstance(data, dict) and isinstance(data.get("statusLine"), dict):
            return data["statusLine"]
    return None


def restore_terminal():
    if sys.stdin.isatty():
        subprocess.run(["stty", "sane"], stdin=sys.stdin, capture_output=True)
        sys.stderr.write("\033[?25h\033[0m\n")
        sys.stderr.flush()


def stop_child(proc, grace=10.0):
    if proc.poll() is not None:
        return
    try:
        proc.send_signal(signal.SIGTERM)
    except Exception:
        return
    deadline = time.time() + grace
    while time.time() < deadline:
        if proc.poll() is not None:
            return
        time.sleep(0.2)
    try:
        proc.kill()
    except Exception:
        pass
    proc.wait()


def print_availability(cfg, state):
    for a in cfg["accounts"]:
        block = account_block(a["name"], state, cfg["threshold"])
        if block:
            say(f"  {a['name']}: {block[0]}, available again {fmt_time(block[1])}", "yellow", err=True)
        else:
            say(f"  {a['name']}: available", "white", err=True)


# Claude Code subcommands (`claude --help`, Claude Code 2.1.309, plus older names) and print-only flags.
# `run` hands them to plain `claude`, so `alias claude='claude-relay run'` keeps `claude setup-token`,
# `claude mcp list`... working.
PASSTHROUGH = {
    "agents", "attach", "auth", "auto-mode", "config", "doctor", "gateway", "import", "install", "kill", "logs",
    "mcp", "migrate-installer", "plugin", "plugins", "purge", "respawn", "rm", "setup-token", "stop",
    "ultrareview", "update", "upgrade", "-h", "--help", "-v", "--version",
}


def cmd_run(claude_args):
    cfg = load_config()
    claude_bin = os.environ.get("CLAUDE_RELAY_CLAUDE_BIN") or cfg.get("claude_bin") or "claude"
    if not shutil.which(claude_bin) and not os.path.exists(claude_bin):
        die(f"Could not find '{claude_bin}'. Install Claude Code or set: {PROG} config claude_bin <path>")
    if claude_args and claude_args[0] in PASSTHROUGH:
        os.execvp(claude_bin, [claude_bin] + list(claude_args))
    if not any(token_get(a["name"], a.get("store", "file")) for a in cfg["accounts"]):
        say(f"{PROG}: no account has a token yet, so this is plain `claude`. Add one with: "
            f"{PROG} accounts add <name>   (token from `claude setup-token`)", "yellow", err=True)
        os.execvp(claude_bin, [claude_bin] + list(claude_args))

    argv, user_settings = split_settings_arg(list(claude_args))
    printing = is_print_mode(argv)
    later_args = restart_args(argv)
    settings_json = json.dumps(relay_settings(user_settings), separators=(",", ":"))

    run_id = uuid.uuid4().hex[:12]
    write_json(run_file(run_id), {"pid": os.getpid(), "started": time.time()})

    stripped = [v for v in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN") if os.environ.get(v)]
    if stripped:
        say(f"{PROG}: ignoring {', '.join(stripped)} so the subscription tokens are used.", "yellow", err=True)

    # Our own Ctrl+C handler (not SIG_IGN) so Claude, after exec, gets the default behaviour.
    signal.signal(signal.SIGINT, lambda *a: None)

    user_statusline = find_user_statusline(user_settings, os.getcwd())

    launched = False
    resume_session = None
    prompt = None
    current = None
    tried = set()
    exit_code = 0
    try:
        while True:
            state = load_state()
            current = choose_account(cfg, state, exclude=tried, prefer=current or desktop_choice(cfg, state))
            if current is None:
                say(f"{PROG}: no account is available right now.", "red", err=True)
                print_availability(cfg, state)
                return exit_code if launched else 2
            acc = find_account(cfg, current)
            token = token_get(current, acc.get("store", "file"))
            if not token:
                say(f"{PROG}: no token stored for '{current}'. Run: {PROG} accounts add {current}", "red", err=True)
                tried.add(current)
                continue
            update_state(lambda st: st.update(active=current))

            args = list(later_args) if launched else list(argv)
            if resume_session:
                args += ["--resume", resume_session]
                if prompt:
                    args.append(prompt)
            cmd = [claude_bin] + args + ["--settings", settings_json]
            env = dict(os.environ)
            for v in stripped:
                env.pop(v, None)
            env.update({"CLAUDE_CODE_OAUTH_TOKEN": token, "CLAUDE_RELAY_RUN": run_id,
                        "CLAUDE_RELAY_ACCOUNT": current, "CLAUDE_RELAY_HOME": str(RELAY_HOME)})
            if user_statusline:
                env["CLAUDE_RELAY_USER_STATUSLINE"] = json.dumps(user_statusline)
            update_run(run_id, lambda r: r.update(account=current, request=None, pending=None,
                                                  blocked=None, session_id=resume_session or r.get("session_id")))
            say(f"{PROG}: account '{current}' ({usage_summary(current, state)})"
                + (f", resuming {resume_session}" if resume_session else ""), "cyan", err=True)

            proc = subprocess.Popen(cmd, env=env)
            launched = True
            switch = None
            while True:
                try:
                    proc.wait(timeout=0.5)
                    break
                except subprocess.TimeoutExpired:
                    pass
                req = load_run(run_id).get("request")
                if not req:
                    continue
                state = load_state()
                nxt = choose_account(cfg, state, exclude={current})
                if nxt is None:
                    update_run(run_id, lambda r: r.update(request=None, blocked=req.get("reason")))
                    continue
                switch = req
                time.sleep(1.5)  # let Claude finish writing the transcript
                stop_child(proc)
                break

            exit_code = proc.returncode if proc.returncode is not None else 1
            if switch is None:
                # Claude exited on its own. In -p mode a usage limit ends the run: continue elsewhere.
                # Claude may exit before the StopFailure hook finishes, so also read the transcript.
                run = load_run(run_id)
                if printing and exit_code != 0 and not run.get("request") and run.get("transcript_path"):
                    failure = last_api_error(run["transcript_path"])
                    if failure:
                        handle_failure(run_id, current, run.get("session_id"), *failure)
                req = load_run(run_id).get("request")
                if printing and req and req.get("session_id"):
                    switch = req
                else:
                    return exit_code
            if not printing:
                restore_terminal()
            old = current
            resume_session = switch.get("session_id") or load_run(run_id).get("session_id")
            if not resume_session:
                say(f"{PROG}: switching accounts but the session id is unknown; starting fresh.", "yellow", err=True)
            prompt = cfg["continue_prompt"] if switch.get("mid_turn") else None
            tried = {old}
            state = load_state()
            nxt = choose_account(cfg, state, exclude=tried, prefer=desktop_choice(cfg, state))
            if nxt is None:
                say(f"{PROG}: '{old}' {switch.get('reason', 'reached its limit')} and no other account is "
                    "available.", "red", err=True)
                print_availability(cfg, load_state())
                return exit_code
            msg = f"'{old}' {switch.get('reason', 'reached its limit')}; switching to '{nxt}'"
            say(f"{PROG}: {msg}.", "yellow", err=True)
            notify(cfg, "claude-relay", msg)
            current = nxt
    finally:
        try:
            run_file(run_id).unlink()
        except Exception:
            pass


# ---------------------------------------------------------------------------
# Internal commands called by Claude Code (status line and hooks)
# ---------------------------------------------------------------------------
def read_stdin_json():
    try:
        data = json.loads(sys.stdin.read() or "{}")
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def run_user_statusline(spec_json, raw_input):
    try:
        spec = json.loads(spec_json)
    except Exception:
        return ""
    if not isinstance(spec, dict) or spec.get("type") != "command" or not spec.get("command"):
        return ""
    if "_statusline" in spec["command"] and PROG in spec["command"]:
        return ""
    try:
        r = subprocess.run(spec["command"], shell=True, input=raw_input, capture_output=True, text=True,
                           timeout=5)
        return r.stdout.rstrip("\n")
    except Exception:
        return ""


def internal_statusline():
    raw = sys.stdin.read()
    try:
        data = json.loads(raw or "{}")
    except Exception:
        data = {}
    run_id = os.environ.get("CLAUDE_RELAY_RUN")
    account = os.environ.get("CLAUDE_RELAY_ACCOUNT")
    cfg = load_config()
    threshold = cfg["threshold"]
    rl = data.get("rate_limits") if isinstance(data, dict) else None
    crossed = None
    if account and isinstance(rl, dict):
        snap = {"updated": time.time()}
        for key, label in WINDOWS:
            w = rl.get(key)
            if isinstance(w, dict) and w.get("used_percentage") is not None:
                used = float(w["used_percentage"])
                snap[key] = {"used": used, "resets_at": w.get("resets_at")}
                if threshold < 100 and used >= threshold and crossed is None:
                    crossed = f"reached {used:.0f}% of its {label} window"
        update_state(lambda st: st["usage"].__setitem__(account, {**(st["usage"].get(account) or {}), **snap}))
    run = {}
    if run_id:
        sid = data.get("session_id") if isinstance(data, dict) else None

        def upd(r):
            if sid:
                r["session_id"] = sid
            if crossed and not r.get("pending") and not r.get("request"):
                r["pending"] = crossed
        run = update_run(run_id, upd)

    lines = []
    user_spec = os.environ.get("CLAUDE_RELAY_USER_STATUSLINE")
    if user_spec:
        out = run_user_statusline(user_spec, raw)
        if out:
            lines.append(out)
    state = load_state()
    if account:
        info = f"⇄ {account} · {usage_summary(account, state)}"
        if run.get("blocked"):
            info += " · no other account available"
        elif run.get("pending"):
            info += " · switching after this turn"
        lines.append(f"\033[2m{info}\033[0m")
    sys.stdout.write("\n".join(lines) + "\n")
    return 0


USAGE_LIMIT_RE = re.compile(r"hit your|usage limit|weekly limit|session limit")


def looks_like_capacity_error(text):
    """A temporary 429 ("this may be a temporary capacity issue"), not the account's usage limit."""
    t = (text or "").lower().replace("rate_limit", "")
    return "capacity" in t and not USAGE_LIMIT_RE.search(t)


def transcript_tail(path, max_bytes=20000):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            return f.read().decode("utf-8", errors="replace")
    except Exception:
        return ""


SWITCH_ERRORS = ("rate_limit", "billing_error", "authentication_failed")
TOKEN_REJECTED = "token rejected"  # the mark's reason; `accounts add` lifts it


def handle_failure(run_id, account, sid, error, message):
    """Decide whether a failed turn means this account cannot be used, and if so ask for a switch.

    `error` is Claude Code's StopFailure type (verified with Claude Code 2.1.296: "rate_limit",
    "authentication_failed", ...) and `message` the error text shown to the user."""
    error, message = str(error or ""), str(message or "")
    if error and error not in SWITCH_ERRORS:
        return False
    if error in ("", "rate_limit") and looks_like_capacity_error(message):
        return False  # a temporary 429, not this account's limit
    cfg = load_config()
    cooldown = time.time() + 60 * int(cfg.get("cooldown_minutes") or 30)
    if error == "authentication_failed":
        reason, short, until = ("had its token rejected (run `claude-relay accounts add` again)",
                                TOKEN_REJECTED, time.time() + 86400)
    elif error == "billing_error":
        reason, short, until = "has a billing problem", "billing problem", cooldown
    else:
        usage = (load_state().get("usage") or {}).get(account) or {}
        resets = [w.get("resets_at") for k, _ in WINDOWS for w in [usage.get(k) or {}]
                  if (w.get("used") or 0) >= 99 and w.get("resets_at")]
        reason, short, until = "hit its usage limit", "hit its usage limit", (max(resets) if resets else cooldown)
    if account:
        update_state(lambda st: st["exhausted"].__setitem__(
            account, {"until": until, "reason": short, "since": time.time()}))

    def upd(r):
        if sid:
            r["session_id"] = sid
        r["request"] = {"session_id": r.get("session_id"), "reason": reason, "mid_turn": True}
    update_run(run_id, upd)
    return True


def transcript_entries(path, max_bytes=200000):
    """The JSON entries in the last `max_bytes` of a transcript."""
    out = []
    for line in transcript_tail(path, max_bytes).splitlines():
        try:
            o = json.loads(line)
        except Exception:
            continue
        if isinstance(o, dict):
            out.append(o)
    return out


def entry_text(entry):
    content = (entry.get("message") or {}).get("content")
    return content if isinstance(content, str) else " ".join(
        p.get("text", "") for p in content or [] if isinstance(p, dict))


def last_api_error(transcript_path):
    """(error, message) if the transcript's last assistant entry is an API error, else None.

    Claude Code records failed turns as {"type": "assistant", "isApiErrorMessage": true,
    "error": "<type>", "message": {"content": [{"text": "..."}]}}."""
    last = None
    for o in transcript_entries(transcript_path):
        if o.get("type") == "assistant":
            last = o
    if not last or not last.get("isApiErrorMessage"):
        return None
    return str(last.get("error") or ""), entry_text(last)


LIMIT_WINDOWS = {"seven_day": "weekly", "five_hour": "5-hour"}


def limit_from_entry(entry):
    """(resets_at, window) when a transcript entry is a turn that failed on the account's usage limit.

    Claude Code (verified with 2.1.299) adds the details to the failed turn:
    "quotaLimits": {"status": "rejected", "resetsAt": <epoch seconds>, "rateLimitType": "seven_day"},
    also under "apiErrorParams": {"rate_limit_info": {...}}. Without them, only a 429 whose text
    names the usage limit counts, with an unknown reset time."""
    if not (isinstance(entry, dict) and entry.get("isApiErrorMessage") and entry.get("error") == "rate_limit"):
        return None
    info = entry.get("quotaLimits")
    if not isinstance(info, dict):
        params = entry.get("apiErrorParams")
        info = params.get("rate_limit_info") if isinstance(params, dict) else None
    info = info if isinstance(info, dict) else {}
    if info.get("status") == "rejected":
        return info.get("resetsAt"), info.get("rateLimitType")
    text = entry_text(entry).lower()
    if USAGE_LIMIT_RE.search(text) and not looks_like_capacity_error(text):
        return None, None
    return None


def limit_reason(window):
    return f"hit its {LIMIT_WINDOWS[window]} limit" if window in LIMIT_WINDOWS else "hit its usage limit"


def internal_hook(event):
    data = read_stdin_json()
    run_id = os.environ.get("CLAUDE_RELAY_RUN")
    account = os.environ.get("CLAUDE_RELAY_ACCOUNT")
    if not run_id:
        return 0
    sid = data.get("session_id")
    tpath = data.get("transcript_path")

    def remember(r):
        if sid:
            r["session_id"] = sid
        if tpath:
            r["transcript_path"] = tpath

    if event == "session-start":
        update_run(run_id, remember)
    elif event == "stop":
        # Also switch after this turn when `watch` or another machine marked this account exhausted,
        # or when Claude Desktop now uses another account.
        state = load_state()
        mark = state["exhausted"].get(account) if account else None
        marked = (exhausted_until(mark) or 0) > time.time()
        follow = desktop_choice(load_config(), state) if state.get("desktop") not in (None, account) else None

        def upd(r):
            remember(r)
            if marked and not r.get("pending"):
                r["pending"] = (mark.get("reason") if isinstance(mark, dict) else None) or "hit its limit"
            elif follow and account and follow != account and not r.get("pending"):
                r["pending"] = "is not the account Claude Desktop uses"
            if r.get("pending") and not r.get("request"):
                r["request"] = {"session_id": r.get("session_id"), "reason": r["pending"], "mid_turn": False}
        update_run(run_id, upd)
    elif event == "stop-failure":
        update_run(run_id, remember)
        message = data.get("last_assistant_message") or transcript_tail(tpath or "")
        handle_failure(run_id, account, sid, data.get("error"), message)
    return 0


# ---------------------------------------------------------------------------
# `claude-relay desktop`: Claude Desktop account switch (macOS)
# ---------------------------------------------------------------------------
def iter_cards(root):
    if not root.exists():
        return []
    return [p for p in root.rglob("local_*.json") if p.is_file()]


class DesktopCheckError(Exception):
    """pgrep could not tell whether Claude Desktop is running."""


def desktop_running():
    """PIDs of Claude Desktop, [] when pgrep finds none. Raises DesktopCheckError when pgrep cannot tell."""
    # macOS pgrep leaves out its own ancestors unless given -a, so from a shell that Claude Desktop
    # started (a Code-tab session) it would not see the app. On Linux, -a lists command lines instead.
    cmd = ["pgrep", "-a", "-x", APP_NAME] if IS_MAC else ["pgrep", "-x", APP_NAME]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as e:
        raise DesktopCheckError(f"could not run pgrep: {e.strerror or e}") from e
    if r.returncode == 0:
        return r.stdout.split()
    if r.returncode == 1:
        return []
    # 2 is a syntax error and 3 a fatal error, on macOS and with Linux procps.
    err = r.stderr.strip().splitlines()
    raise DesktopCheckError(f"pgrep exited with code {r.returncode}" + (f": {err[0]}" if err else ""))


def desktop_ancestor(pids):
    """The PID in `pids` that this process runs under, e.g. Claude Desktop for a Code-tab shell."""
    try:
        r = subprocess.run(["ps", "-A", "-o", "pid=,ppid="], capture_output=True, text=True)
    except Exception:
        return None
    parent = dict(line.split() for line in r.stdout.splitlines() if len(line.split()) == 2)
    pid, seen = str(os.getpid()), set()
    while pid in parent and pid not in seen:
        seen.add(pid)
        pid = parent[pid]
        if pid in pids:
            return pid
    return None


def quit_desktop(timeout=30):
    """True once Claude Desktop has quit. DesktopCheckError passes through: a failed check is not a quit."""
    pids = desktop_running()
    if not pids:
        return True
    inside = desktop_ancestor(pids)
    if inside:
        say(f"Warning: this command is running inside Claude Desktop (PID {inside}). Quitting the app "
            "will most likely stop it before it copies anything. Run it from Terminal.app instead.", "yellow")
    say("Quitting Claude Desktop...", "cyan")
    try:
        subprocess.run(["osascript", "-e", f'quit app "{APP_NAME}"'], capture_output=True, text=True, timeout=15)
    except Exception:
        pass
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not desktop_running():
            time.sleep(1)  # let the app finish writing its files
            return True
        time.sleep(0.5)
    return False


def open_desktop():
    try:
        subprocess.run(["open", "-a", APP_NAME], capture_output=True, text=True, timeout=15)
        say("Claude Desktop reopened.", "cyan")
    except Exception:
        say("Could not reopen Claude Desktop; open it manually.", "yellow")


def to_epoch_ms(iso, fallback_ts):
    if iso:
        try:
            s = str(iso).strip()
            if s.endswith("Z"):
                s = s[:-1] + "+00:00"
            m = re.match(r"^(.*?\.)(\d+)(.*)$", s)
            if m:
                s = m.group(1) + (m.group(2) + "000000")[:6] + m.group(3)
            dt = datetime.fromisoformat(s)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            return int(dt.timestamp() * 1000)
        except Exception:
            pass
    return int(fallback_ts * 1000)


SKIP_USER = [
    re.compile(r"^\s*<"),
    re.compile(r"^This session is being continued"),
    re.compile(r"^\s*Caveat:"),
    re.compile(r"^Base directory for this skill"),
]


def get_meta(path):
    """Read cwd, creation timestamp and a title from the first 400 lines of a transcript."""
    cwd = created = ai = summ = usr = None
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for i, line in enumerate(f, 1):
                if i > 400:
                    break
                if not line.strip():
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if not isinstance(o, dict):
                    continue
                if not created and o.get("timestamp"):
                    created = o["timestamp"]
                if not cwd and o.get("cwd"):
                    cwd = o["cwd"]
                if not ai and o.get("type") == "ai-title" and o.get("aiTitle"):
                    ai = o["aiTitle"]
                if not summ and o.get("type") == "summary" and o.get("summary"):
                    summ = o["summary"]
                if not usr and o.get("type") == "user" and isinstance(o.get("message"), dict):
                    c = o["message"].get("content")
                    txt = None
                    if isinstance(c, str):
                        txt = c
                    elif isinstance(c, list):
                        for part in c:
                            if isinstance(part, dict) and part.get("type") == "text":
                                txt = part.get("text")
                                break
                    if txt and not any(rx.search(txt) for rx in SKIP_USER):
                        usr = txt
                if cwd and created and ai:
                    break
    except Exception:
        pass
    title = ai or (re.sub(r"\s+", " ", summ) if summ else None) or (re.sub(r"\s+", " ", usr) if usr else None)
    if title and len(title) > 80:
        title = title[:80]
    return cwd, created, title


def find_key(obj, key):
    """Return the first string value stored under `key` anywhere in a JSON structure."""
    if isinstance(obj, dict):
        v = obj.get(key)
        if isinstance(v, str) and v:
            return v
        children = obj.values()
    elif isinstance(obj, list):
        children = obj
    else:
        return None
    for child in children:
        found = find_key(child, key)
        if found:
            return found
    return None


def read_desktop_account(app_dir):
    """Account Claude Desktop is signed into (it does not update ~/.claude.json)."""
    for name in DESKTOP_CONFIG_FILES:
        path = app_dir / name
        if path.exists():
            acct = find_key(load_json(path), "lastKnownAccountUuid")
            if acct:
                return acct, path
    return None, None


def read_cli_account():
    if not CLAUDE_JSON.exists():
        return None
    cj = load_json(CLAUDE_JSON)
    if isinstance(cj, dict):
        oa = cj.get("oauthAccount") or {}
        a, o = oa.get("accountUuid"), oa.get("organizationUuid")
        if a and o:
            return a, o, oa.get("emailAddress")
    try:
        raw = CLAUDE_JSON.read_text(encoding="utf-8", errors="replace")
        m = re.search(
            r'"oauthAccount"\s*:\s*\{[\s\S]*?"accountUuid"\s*:\s*"([0-9a-fA-F\-]+)"'
            r'[\s\S]*?"organizationUuid"\s*:\s*"([0-9a-fA-F\-]+)"',
            raw,
        )
        if m:
            return m.group(1), m.group(2), None
    except Exception:
        pass
    return None


def resolve_org(cards_root, acct, cli):
    """Pick the organization folder for an account; Claude Desktop creates it on first use."""
    acct_dir = cards_root / acct
    orgs = sorted((p for p in acct_dir.iterdir() if p.is_dir()), key=lambda p: p.stat().st_mtime,
                  reverse=True) if acct_dir.is_dir() else []
    if cli and cli[0] == acct:
        if not orgs or any(p.name == cli[1] for p in orgs):
            return cli[1]
    if orgs:
        return orgs[0].name
    return None


def read_current_account(cards_root):
    """Return (account, org, source, problem). Claude Desktop's own config wins over ~/.claude.json."""
    cli = read_cli_account()
    acct, path = read_desktop_account(cards_root.parent)
    if acct:
        org = resolve_org(cards_root, acct, cli)
        if org:
            return acct, org, str(path), None
        return acct, None, str(path), (
            f"Claude Desktop is signed in as {acct}, but it has no session folder yet. "
            "Open the Code tab in Claude Desktop once, then run again.")
    if cli:
        return cli[0], cli[1], str(CLAUDE_JSON), None
    return None, None, None, (
        f"Could not read the logged-in account from Claude Desktop ({cards_root.parent}) "
        f"or from {CLAUDE_JSON}.")


def same_dir(a, b):
    try:
        return os.path.realpath(a) == os.path.realpath(b)
    except Exception:
        return str(a) == str(b)


def make_backup(cards_root):
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    bk = Path(f"{cards_root}_backup_{stamp}")
    n = 2
    while bk.exists():
        bk = Path(f"{cards_root}_backup_{stamp}_{n}")
        n += 1
    shutil.copytree(cards_root, bk)
    return bk


def desktop_list(cards_root):
    say(f"Card folder: {cards_root}", "cyan")
    if not cards_root.exists():
        say("The folder does not exist. Open the Code tab in Claude Desktop at least once, "
            "or point to the right folder with --cards-dir.", "yellow")
        return 1
    acct, org, source, problem = read_current_account(cards_root)
    found = False
    for acct_dir in sorted(p for p in cards_root.iterdir() if p.is_dir()):
        for org_dir in sorted(p for p in acct_dir.iterdir() if p.is_dir()):
            found = True
            n = len(list(org_dir.glob("local_*.json")))
            mark = "  <- logged in" if (acct_dir.name, org_dir.name) == (acct, org) else ""
            say(f"  {acct_dir.name}/{org_dir.name}: {n} card(s){mark}", "white")
    if not found:
        say("  (no account folders yet)", "gray")
    if acct and org:
        say(f"Logged-in account (from {source}): {acct} / {org}", "cyan")
    if problem:
        say(problem, "yellow")
    return 0


SYNC_FIELDS = ("lastActivityAt", "title", "titleSource")


def sync_card(src_card, dst_path, dry_run):
    """Bring a card's last-activity time and title up to date from a newer copy in another account."""
    dst = load_json(dst_path)
    if not isinstance(dst, dict):
        return False
    if (src_card.get("lastActivityAt") or 0) <= (dst.get("lastActivityAt") or 0):
        return False
    changed = False
    for k in SYNC_FIELDS:
        if k in src_card and src_card[k] != dst.get(k):
            dst[k] = src_card[k]
            changed = True
    if changed and not dry_run:
        with open(dst_path, "w", encoding="utf-8") as fh:
            json.dump(dst, fh, ensure_ascii=False, separators=(",", ":"))
    return changed


TASK_RUN_FIELDS = ("lastRunAt", "lastScheduledFor", "notifySessionId")


def copy_scheduled_tasks(cards_root, dest, dry_run):
    """Add the recurring Claude Desktop scheduled tasks of other accounts to `dest`'s scheduled-tasks.json.

    The prompts in ~/.claude/scheduled-tasks are shared, but each account registers its own tasks (see
    register_resume_task). Tasks `dest` already has stay as they are; one-time tasks and the record of
    a task's last run in the other account are left behind. Returns how many tasks were copied, or None
    when `dest`'s file exists but cannot be read."""
    path = dest / "scheduled-tasks.json"
    data = load_json(path) if path.exists() else {}
    if not isinstance(data, dict) or not isinstance(data.get("scheduledTasks") or [], list):
        return None
    tasks = list(data.get("scheduledTasks") or [])
    have = {None, RESUME_TASK} | {t.get("id") for t in tasks if isinstance(t, dict)}
    copied = 0
    # Newest file first: when two accounts have the same task, the one used last wins.
    for src in sorted(cards_root.glob("*/*/scheduled-tasks.json"), key=lambda p: (-p.stat().st_mtime, str(p))):
        if same_dir(src.parent, dest):
            continue
        other = load_json(src)
        for t in (other.get("scheduledTasks") if isinstance(other, dict) else None) or []:
            if isinstance(t, dict) and t.get("cronExpression") and t.get("id") not in have:
                tasks.append({k: v for k, v in t.items() if k not in TASK_RUN_FIELDS})
                have.add(t["id"])
                copied += 1
    if copied and not dry_run:
        data["scheduledTasks"] = tasks
        write_json(path, data)  # 0600, like Claude Desktop's own copy
    return copied


def restart_remote_helpers(hosts, dry_run):
    """Claude Desktop starts a helper server on each SSH host with the credentials of the account that
    started it. Stopping it makes Claude Desktop start a fresh one with the current account."""
    if not hosts:
        return
    remote_cmd = 'pkill -u "$(id -un)" -f "$HOME/.claude/remote/(srv|ccd-cli)/" ; true'
    for host in hosts:
        if dry_run:
            say(f"Would restart Claude Desktop's helpers on {host}.", "yellow")
            continue
        try:
            r = subprocess.run(ssh_command(host) + [remote_cmd],
                               capture_output=True, text=True, timeout=30)
            if r.returncode == 0:
                say(f"Restarted Claude Desktop's helpers on {host}.", "green")
            else:
                say(f"Could not reach {host} ({(r.stderr or '').strip() or 'ssh failed'}). "
                    f"On that host run: pkill -u \"$USER\" -f \"$HOME/.claude/remote/(srv|ccd-cli)/\"", "yellow")
        except Exception as e:
            say(f"Could not reach {host}: {e}", "yellow")


def cmd_desktop(args):
    cards_root = Path(args.cards_dir).expanduser() if args.cards_dir else DEFAULT_CARDS
    projects_root = Path(args.projects_dir).expanduser() if args.projects_dir else DEFAULT_PROJECTS
    if not IS_MAC:
        say("Note: `desktop` is meant for Claude Desktop on macOS.", "yellow")
    if args.list:
        return desktop_list(cards_root)

    try:
        if args.quit:
            if not quit_desktop():
                say("Claude Desktop did not quit in time. Quit it with Cmd+Q and run again.", "yellow")
                return 1
        elif not args.ignore_running and not args.dest_root and not args.dry_run:
            pids = desktop_running()
            if pids:
                say(f"Claude Desktop is still running (PID {', '.join(pids)}).", "yellow")
                say("Quit it completely with Cmd+Q and run again, or pass --quit to do it for you.", "yellow")
                return 1
    except DesktopCheckError as e:
        # The app rewrites its card list when it exits, so writing while it may be open is unsafe.
        say(f"Could not check whether Claude Desktop is running ({e}), so nothing was copied.", "yellow")
        override = "--ignore-running instead of --quit" if args.quit else "--ignore-running"
        say(f"Make sure it has quit completely (Cmd+Q), then run again with {override}.", "yellow")
        return 1

    if args.dest_root:
        dest = Path(args.dest_root).expanduser()
        acct = None
    else:
        if args.account and args.org:
            acct, org = args.account, args.org
        elif args.account or args.org:
            say("--account and --org must be used together.", "yellow")
            return 2
        else:
            acct, org, source, problem = read_current_account(cards_root)
            if not (acct and org):
                say(problem, "yellow")
                say("You can also pass --account and --org (see --list).", "yellow")
                return 1
        dest = cards_root / acct / org
        say(f"Logged-in account : {acct}", "cyan")
        say(f"Organization      : {org}", "cyan")
        if not (args.account and args.org):
            say(f"Detected from     : {source}", "gray")
    say(f"Target folder     : {dest}", "cyan")

    if not cards_root.exists() and not args.dest_root:
        say(f"Warning: {cards_root} does not exist yet. If Claude Desktop stores cards elsewhere, "
            "run with --list or --cards-dir.", "yellow")

    if args.dry_run:
        say("Dry run: nothing will be written.", "yellow")
    else:
        dest.mkdir(parents=True, exist_ok=True)

    if not args.no_backup and not args.dry_run and cards_root.exists():
        bk = make_backup(cards_root)
        say(f"Backup            : {bk}", "green")

    all_cards = iter_cards(cards_root)
    tmpl = load_json(min(all_cards, key=lambda p: p.stat().st_size)) if all_cards else None
    tmpl = tmpl if isinstance(tmpl, dict) else {}
    def_model = tmpl.get("model") or "claude-opus-4-8"
    def_effort = tmpl.get("effort") or "high"
    def_chrome = tmpl.get("chromePermissionMode") or "default"
    def_mcp = tmpl.get("remoteMcpServersConfig") if tmpl else None

    have = {}
    if dest.exists():
        for f in dest.glob("local_*.json"):
            o = load_json(f)
            if isinstance(o, dict) and o.get("cliSessionId"):
                have[str(o["cliSessionId"]).lower()] = f

    copied = synced = 0
    for f in sorted(all_cards, key=lambda p: -((load_json(p) or {}).get("lastActivityAt") or 0)):
        if same_dir(f.parent, dest):
            continue
        o = load_json(f)
        if not isinstance(o, dict) or not o.get("cliSessionId"):
            continue
        key = str(o["cliSessionId"]).lower()
        if key in have:
            if have[key] is not None and sync_card(o, have[key], args.dry_run):
                synced += 1
            continue
        target = dest / f.name
        if not args.dry_run:
            if target.exists():
                target = dest / f"local_{uuid.uuid4()}.json"
            shutil.copy2(f, target)
        have[key] = target if not args.dry_run else None
        copied += 1
    say(f"{'Would copy' if args.dry_run else 'Copied'} {copied} card(s) from other accounts"
        f"{f'; updated {synced} with newer activity' if synced else ''}.", "green")

    tasks = copy_scheduled_tasks(cards_root, dest, args.dry_run)
    if tasks is None:
        say(f"Could not read {dest / 'scheduled-tasks.json'}, so no scheduled tasks were copied.", "yellow")
    else:
        say(f"{'Would copy' if args.dry_run else 'Copied'} {tasks} scheduled task(s) from other accounts.", "green")

    if args.existing_cards_only:
        say("--existing-cards-only: CLI / VS Code sessions skipped.", "yellow")
    elif not projects_root.exists():
        say(f"Warning: {projects_root} does not exist; no transcripts to scan.", "yellow")
    else:
        generated = skipped = 0
        for t in projects_root.rglob("*.jsonl"):
            if not t.is_file() or t.parent.name == "subagents":
                continue
            cli = t.stem
            key = cli.lower()
            if key in have:
                skipped += 1
                continue
            cwd, created_iso, title = get_meta(t)
            cwd = cwd or ""
            st = t.stat()
            birth = getattr(st, "st_birthtime", st.st_mtime)
            created = to_epoch_ms(created_iso, birth)
            last = int(st.st_mtime * 1000)
            if not title:
                leaf = os.path.basename(cwd.rstrip("/")) if cwd else "session"
                title = f"{leaf} (recovered)"
            g = str(uuid.uuid4())
            rec = {
                "sessionId": f"local_{g}", "cliSessionId": cli, "cwd": cwd, "originCwd": cwd,
                "lastFocusedAt": last, "createdAt": created, "lastActivityAt": last,
                "model": def_model, "effort": def_effort, "isArchived": False,
                "title": title, "titleSource": "auto", "permissionMode": "auto",
                "remoteMcpServersConfig": def_mcp, "chromePermissionMode": def_chrome,
                "completedTurns": 1, "alwaysAllowedReasons": None,
                "sessionPermissionUpdates": None, "classifierSummaryEnabled": True,
            }
            if not args.dry_run:
                with open(dest / f"local_{g}.json", "w", encoding="utf-8") as fh:
                    json.dump(rec, fh, ensure_ascii=False, separators=(",", ":"))
            have[key] = None
            generated += 1
        verb = "Would create" if args.dry_run else "Created"
        say(f"{verb} {generated} new card(s); {skipped} already present.", "green")

    hosts = [] if args.no_remotes else (args.remote or load_config().get("remotes") or [])
    if not args.dest_root:
        restart_remote_helpers(hosts, args.dry_run)

    if acct:
        cli = read_cli_account()
        if cli and cli[0] != acct:
            who = cli[2] or cli[0]
            say(f"Note: the `claude` command in your terminal is signed in as {who}, not the account Claude "
                f"Desktop uses. Use `{PROG} run` (or /login in claude) for terminal sessions.", "yellow")

    if args.dry_run:
        say("Dry run finished.", "white")
    else:
        total = len(list(dest.glob("local_*.json")))
        say(f"Done. This account's Code tab now has {total} session card(s).", "white")
        if args.reopen:
            open_desktop()
        else:
            say("Open Claude Desktop -> Code tab: your sessions should be listed.", "cyan")
    return 0


# ---------------------------------------------------------------------------
# `claude-relay watch`: notice usage limits on this Mac and the SSH hosts, and follow account switches
# ---------------------------------------------------------------------------
WATCH_INTERVAL = 30   # seconds between passes
QUIET_SECONDS = 60    # move the sessions only once no Desktop session has written for this long
SCAN_OVERLAP = 60     # re-read this far before the previous pass; entries are de-duplicated by uuid
RESTORE_RETRY = 300   # wait this long after a failed move before trying again
RESTORE_ATTEMPTS = 3  # then stop asking Claude Desktop to quit, and say how to do it by hand


def scan_transcripts(projects_root, since, check=()):
    """What `watch` needs from one machine's transcripts:
    - events: usage-limit errors in Claude Desktop sessions written since `since`;
    - latest_write: when a Claude Desktop session last wrote (among transcripts changed since `since`);
    - stopped: the `check` sessions whose last turn still ends on a usage-limit error."""
    check = set(check)
    events, stopped, latest = [], [], 0.0
    paths = projects_root.glob("*/*.jsonl") if projects_root.is_dir() else []
    for path in paths:
        cli = path.stem
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if mtime < since and cli not in check:
            continue
        entries = transcript_entries(path, 400000)
        if cli in check:
            last = next((o for o in reversed(entries) if o.get("type") == "assistant"), None)
            if last is not None and limit_from_entry(last):
                stopped.append(cli)
        if mtime < since:
            continue
        if next((o.get("entrypoint") for o in reversed(entries) if o.get("entrypoint")), None) == "claude-desktop":
            latest = max(latest, mtime)
        for o in entries:
            if o.get("entrypoint") != "claude-desktop":
                continue
            limit = limit_from_entry(o)
            ts = to_epoch_ms(o.get("timestamp"), 0) / 1000
            if limit and ts >= since:
                events.append({"uuid": o.get("uuid") or f"{cli}@{ts}", "cli": cli, "ts": ts,
                               "until": limit[0], "window": limit[1]})
    return {"events": events, "latest_write": latest, "stopped": stopped}


def internal_sync(payload):
    """Run on an SSH host by `watch`, which pipes this script to `python3 -`: take the Mac's
    `exhausted` marks and `cleared` times (and the account to prefer), then report this host's
    transcripts, marks and cleared times."""
    try:
        p = json.loads(payload)
    except Exception:
        p = {}
    cfg = load_config()

    def upd(st):
        merge_marks(st, p)
        if p.get("active") and find_account(cfg, p["active"]):
            st["active"] = p["active"]
        if p.get("desktop"):
            st["desktop"], st["desktop_at"] = p["desktop"], time.time()
    st = update_state(upd)
    out = scan_transcripts(DEFAULT_PROJECTS, float(p["since"]), p.get("check") or []) if "since" in p else {}
    out["exhausted"], out["cleared"] = st["exhausted"], st["cleared"]
    sys.stdout.write(json.dumps(out) + "\n")
    return 0


_OWN_SCRIPT = []


def own_script():
    """This script's source, read once: sent to SSH hosts by `watch` and `remote install`."""
    if not _OWN_SCRIPT:
        _OWN_SCRIPT.append(Path(__file__).read_text(encoding="utf-8"))
    return _OWN_SCRIPT[0]


def ssh_command(host):
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host]


def remote_sync(host, payload):
    """(reply, None) from `_sync` on `host`, or (None, why it failed). The host needs only python3."""
    command = "python3 - _sync " + shlex.quote(json.dumps(payload, separators=(",", ":")))
    try:
        r = subprocess.run(ssh_command(host) + [command], input=own_script(), capture_output=True, text=True,
                           timeout=120)
    except Exception as e:
        return None, str(e)
    if r.returncode != 0:
        err = (r.stderr or "").strip().splitlines()
        return None, err[-1] if err else f"ssh exited with code {r.returncode}"
    try:
        return json.loads(r.stdout.strip().splitlines()[-1]), None
    except Exception:
        return None, "unexpected reply"


def desktop_key(cfg, account):
    """The claude-relay name linked to a Claude Desktop account (`accounts link`), else the account id."""
    for a in cfg["accounts"]:
        if a.get("desktop_account") == account:
            return a["name"]
    return account


def desktop_account_at(history, ts):
    """The Claude Desktop account signed in at `ts`, from `watch`'s history; None before it started."""
    found = None
    for since, account in history:
        if since > ts:
            break
        found = account
    return found


def next_desktop_account(cfg, cards_root, current, exhausted, now):
    candidates = [a["desktop_account"] for a in cfg["accounts"] if a.get("desktop_account")]
    if cards_root.is_dir():
        candidates += sorted(p.name for p in cards_root.iterdir() if p.is_dir())
    for account in dict.fromkeys(candidates):
        name = desktop_key(cfg, account)
        if account != current and (exhausted_until(exhausted.get(name)) or 0) <= now:
            return name
    return None


def write_resume_list(cfg, account, dest, pending):
    """resume.json: the sessions to resume after moving them to `account` (card folder `dest`).
    Returns them and whether the file was written; a write that fails is logged."""
    cards = {}
    for f in dest.glob("local_*.json"):
        o = load_json(f)
        if isinstance(o, dict) and o.get("cliSessionId"):
            cards[str(o["cliSessionId"]).lower()] = o
    sessions = []
    for p in pending:
        card = cards.get(p["cli"].lower())
        if card:
            sessions.append({"sessionId": card.get("sessionId"), "cliSessionId": p["cli"], "title": card.get("title"),
                             "host": p["host"], "stoppedAt": p["ts"]})
    try:
        write_json(RESUME_FILE, {"created": time.time(), "account": desktop_key(cfg, account), "sessions": sessions})
    except OSError as e:
        wsay(f"Could not write {RESUME_FILE} ({e}).", "yellow")
        return sessions, False
    return sessions, True


RESUME_TASK = "claude-relay-resume"
RESUME_WAVE = 10


def register_resume_task(cfg, dest):
    """Make Claude Desktop resume the sessions in resume.json as soon as it opens: a one-time scheduled
    task that is already due, registered in the account's card folder while the app is closed.

    Claude Desktop keeps each task's prompt in ~/.claude/scheduled-tasks/<id>/SKILL.md and, per
    account, {"scheduledTasks": [{"id", "fireAt": <epoch ms>, "enabled", "filePath", "cwd", ...}]} in
    scheduled-tasks.json (format observed in Claude Desktop, October 2026). The task runs in
    RELAY_HOME so it reads resume.json without a permission prompt. A scheduled-tasks.json that exists
    but cannot be read is left alone, with a warning; so is a write that fails. Returns whether the task
    was added."""
    path = dest / "scheduled-tasks.json"
    data = load_json(path) if path.exists() else {}
    if not isinstance(data, dict) or not isinstance(data.get("scheduledTasks") or [], list):
        wsay(f"Could not read {path}, so the resume task was not added. Resume the sessions in {RESUME_FILE} "
             "by hand.", "yellow")
        return False
    skill = HOME / ".claude" / "scheduled-tasks" / RESUME_TASK / "SKILL.md"
    try:  # the prompt first, so no task ever points at a missing file
        skill.parent.mkdir(parents=True, exist_ok=True)
        skill.write_text(
            "---\n"
            f"name: {RESUME_TASK}\n"
            "description: Resume the Claude Code sessions that stopped on a usage limit (written by claude-relay).\n"
            "---\n\n"
            "claude-relay moved this account's Code-tab sessions here after another account hit its usage limit.\n\n"
            f"1. Read `resume.json` in the current folder ({RELAY_HOME}). Its `sessions` list has a `sessionId` "
            "and a `title` for each session to resume.\n"
            "2. Call `list_sessions` (limit 100) and leave out any of those sessions that is already running.\n"
            "3. Send each remaining session this message with `SendMessage` (`to` = its sessionId), word for "
            "word:\n\n"
            f"   {cfg.get('resume_prompt') or DEFAULT_CONFIG['resume_prompt']}\n\n"
            f"   Send at most {RESUME_WAVE} at a time; before the next {RESUME_WAVE}, call `list_sessions` again "
            f"and wait until fewer than {RESUME_WAVE} of them are running.\n"
            "4. Do nothing else: do not run commands, edit files or answer for the sessions. Finish with one line: "
            "how many sessions you messaged and which ones you skipped.\n",
            encoding="utf-8")
        tasks = [t for t in data.get("scheduledTasks") or [] if isinstance(t, dict) and t.get("id") != RESUME_TASK]
        now_ms = int(time.time() * 1000)
        tasks.append({"id": RESUME_TASK, "displayName": "claude-relay: resume sessions", "fireAt": now_ms,
                      "enabled": True, "filePath": str(skill), "createdAt": now_ms, "cwd": str(RELAY_HOME)})
        data["scheduledTasks"] = tasks
        write_json(path, data)  # 0600, like Claude Desktop's own copy
    except OSError as e:
        wsay(f"Could not write the resume task ({e}), so it was not added. Resume the sessions in "
             f"{RESUME_FILE} by hand.", "yellow")
        return False
    return True


def wsay(msg, color="gray"):
    say(f"{datetime.now():%Y-%m-%d %H:%M:%S} {msg}", color)


def watch_pass(cfg):
    now = time.time()
    st = load_state()
    w = dict(st.get("watch") or {})
    account = read_desktop_account(DEFAULT_CARDS.parent)[0]
    history = [h for h in w.get("history") or [] if isinstance(h, list) and len(h) == 2]
    switched = bool(account) and (not history or history[-1][1] != account)
    if switched:
        history = (history + [[now, account]])[-20:]
    active = desktop_key(cfg, account) if switched else None
    since = dict(w.get("since") or {})
    pending = [p for p in w.get("pending") or [] if isinstance(p, dict) and p.get("cli")]
    check = {}
    for p in pending:
        check.setdefault(p["host"], []).append(p["cli"])

    # SSH hosts first: Claude Desktop may keep a local copy of a remote session's transcript.
    merged = {"exhausted": dict(st["exhausted"]), "cleared": dict(st["cleared"])}
    marks, cleared = merged["exhausted"], merged["cleared"]
    results, unreachable = {}, []
    for host in cfg.get("remotes") or []:
        payload = {"since": max(0, (since.get(host) or now) - SCAN_OVERLAP), "exhausted": st["exhausted"],
                   "cleared": st["cleared"], "check": check.get(host, [])}
        if active:
            payload["active"] = active
        if account:
            payload["desktop"] = desktop_key(cfg, account)  # `run` on the host follows it
        reply, err = remote_sync(host, payload)
        if reply is None:
            wsay(f"Could not reach {host} ({err}).", "yellow")
            unreachable.append(host)
            continue
        results[host] = reply
        since[host] = now
        merge_marks(merged, reply)
    results["local"] = scan_transcripts(DEFAULT_PROJECTS, max(0, (since.get("local") or now) - SCAN_OVERLAP),
                                        check.get("local", []))
    since["local"] = now

    # Sessions still stopped on a limit stay pending; new limit errors add sessions and marks.
    pending = [p for p in pending if p["host"] not in results or p["cli"] in results[p["host"]]["stopped"]]
    seen = list(w.get("seen") or [])
    seen_set, new_marks = set(seen), {}
    for host, res in results.items():
        for ev in res.get("events") or []:
            if ev["uuid"] in seen_set:
                continue
            seen.append(ev["uuid"])
            seen_set.add(ev["uuid"])
            owner = desktop_account_at(history, ev["ts"])
            if not owner:
                continue  # before `watch` knew which account was signed in
            if not any(p["host"] == host and p["cli"] == ev["cli"] for p in pending):
                pending.append({"host": host, "cli": ev["cli"], "account": owner, "ts": ev["ts"]})
            until = ev.get("until") or ev["ts"] + 60 * int(cfg.get("cooldown_minutes") or 30)
            name = desktop_key(cfg, owner)
            # A limit from before the account was cleared stays cleared, even when first seen now.
            if until > now and ev["ts"] > (cleared.get(name) or 0) and until > (exhausted_until(marks.get(name)) or 0):
                marks[name] = {"until": until, "reason": limit_reason(ev.get("window")), "since": ev["ts"]}
                new_marks[name] = owner
    for name, owner in new_marks.items():
        mark = marks[name]
        msg = f"{name} {mark['reason']} until {fmt_time(mark['until'])}."
        wsay(msg, "yellow")
        if owner == account:
            nxt = next_desktop_account(cfg, DEFAULT_CARDS, account, marks, now)
            notify(cfg, "claude-relay", msg + (f" Sign Claude Desktop in to {nxt}; claude-relay will move your "
                                               "sessions." if nxt else " No other Claude Desktop account is free."))
    if new_marks:  # let the hosts' `claude-relay run` switch now rather than on the next pass
        for host in results:
            if host != "local":
                remote_sync(host, merged)

    # Claude Desktop is signed in to another account: move the sessions once it is quiet.
    restored = w.get("restored")
    if account and restored is None:
        w["restored"] = account  # first pass: nothing to move
    elif account and account != restored and w.get("gave_up") != account and now >= (w.get("retry_at") or 0):
        name = desktop_key(cfg, account)
        org = resolve_org(DEFAULT_CARDS, account, read_cli_account())
        latest = max(r.get("latest_write") or 0 for r in results.values())
        if not org:
            wsay(f"Claude Desktop is signed in to {name}, which has no session folder yet. Open the Code tab "
                 "in Claude Desktop.", "yellow")
        elif unreachable:  # its sessions may still be writing
            wsay(f"Claude Desktop is signed in to {name}; waiting to reach {', '.join(unreachable)} before "
                 "moving the sessions.", "yellow")
        elif now - latest < QUIET_SECONDS:
            wsay(f"Claude Desktop is signed in to {name}; waiting until no session has written for "
                 f"{QUIET_SECONDS} s to move the sessions.", "cyan")
            if w.get("waiting_for") != account:
                w["waiting_for"] = account
                notify(cfg, "claude-relay", f"Claude Desktop is signed in to {name}. Sessions move as soon as "
                                            "none has written for a minute.")
        else:
            wsay(f"Claude Desktop is signed in to {name}: moving the sessions.", "white")
            try:
                rc = cmd_desktop(build_parser().parse_args(["desktop", "--quit", "--existing-cards-only"]))
            except Exception as e:
                wsay(f"Moving the sessions failed: {e!r}", "red")
                rc = 1
            if rc == 0:
                stopped = {(h, c) for h, r in results.items() for c in r["stopped"]}
                to_resume = [p for p in pending if p["account"] != account and (p["host"], p["cli"]) in stopped]
                sessions, listed = write_resume_list(cfg, account, DEFAULT_CARDS / account / org, to_resume)
                added = listed
                if listed and sessions:  # while the app is still closed, so it runs the task as it opens
                    added = register_resume_task(cfg, DEFAULT_CARDS / account / org)
                open_desktop()
                pending = [p for p in pending if p not in to_resume]
                w["restored"] = account
                for k in ("waiting_for", "failures", "retry_at"):
                    w.pop(k, None)
                msg = f"Sessions moved to {name}; {len(sessions)} session(s) stopped on the limit."
                if added:
                    wsay(f"{msg} List: {RESUME_FILE}", "green")
                else:  # they will not resume on their own
                    if listed:
                        msg += f" Resume them by hand: the list is in {RESUME_FILE}."
                    elif sessions:  # no list to point at: name them
                        titles = ", ".join(f'"{s["title"] or s["cliSessionId"]}"' for s in sessions)
                        msg += f" Resume them by hand: {titles}."
                    wsay(msg, "yellow")
                notify(cfg, "claude-relay", msg)
            else:
                open_desktop()  # do not leave the app closed; if it never quit, this only brings it forward
                w["failures"] = (w.get("failures") or 0) + 1
                manual = (f"Quit Claude Desktop (Cmd+Q) and run in Terminal.app: "
                          f"{PROG} desktop --existing-cards-only --reopen")
                if w["failures"] >= RESTORE_ATTEMPTS:
                    w["gave_up"] = account  # until Claude Desktop is signed in to another account
                    wsay(f"Could not move the sessions after {RESTORE_ATTEMPTS} tries. {manual}", "red")
                    notify(cfg, "claude-relay", f"Could not move the sessions to {name}. {manual}")
                else:
                    w["retry_at"] = now + RESTORE_RETRY
                    wsay(f"Could not move the sessions; trying again in {RESTORE_RETRY // 60} min.", "yellow")

    w.update(history=history, since=since, pending=pending, seen=seen[-500:])

    def upd(s):
        merge_marks(s, merged)  # against the state as it is now: a `reset` during this pass still wins
        if active and find_account(cfg, active):
            s["active"] = active
        if account:  # `run` here follows it
            s["desktop"], s["desktop_at"] = desktop_key(cfg, account), time.time()
        s["watch"] = w
    update_state(upd)
    return 0


def cmd_watch(args):
    if args.once:
        return watch_pass(load_config())
    wsay(f"{PROG} {__version__} watching every {args.interval} s.", "white")
    while True:
        try:
            watch_pass(load_config())
        except Exception as e:  # keep watching; one bad pass must not stop the agent
            wsay(f"Pass failed: {e!r}", "red")
        time.sleep(args.interval)


# ---------------------------------------------------------------------------
# `claude-relay service`: run `watch` as a launchd agent (macOS)
# ---------------------------------------------------------------------------
def launch_agent_plist():
    return HOME / "Library" / "LaunchAgents" / f"{LAUNCH_LABEL}.plist"


def watch_program():
    """How launchd starts `watch`: the `claude-relay` on PATH when it is this script (a Homebrew
    upgrade keeps that path working), else this Python with this file."""
    me = os.path.realpath(__file__)
    found = shutil.which(PROG)
    if found and os.path.realpath(found) == me:
        return [found, "watch"]
    return [sys.executable, me, "watch"]


def cmd_service(args):
    if not IS_MAC:
        say("`service` runs `watch` as a launchd agent on the Mac. SSH hosts need nothing running: the "
            "Mac's `watch` reads and updates them over SSH.", "yellow")
        return 1
    plist = launch_agent_plist()
    domain = f"gui/{os.getuid()}"
    if args.action == "install":
        RELAY_HOME.mkdir(parents=True, exist_ok=True)
        subprocess.run(["launchctl", "bootout", f"{domain}/{LAUNCH_LABEL}"], capture_output=True)
        plist.parent.mkdir(parents=True, exist_ok=True)
        with open(plist, "wb") as f:
            plistlib.dump({
                "Label": LAUNCH_LABEL, "ProgramArguments": watch_program(), "RunAtLoad": True, "KeepAlive": True,
                "ProcessType": "Background", "StandardOutPath": str(WATCH_LOG), "StandardErrorPath": str(WATCH_LOG),
                "EnvironmentVariables": {"PATH": os.environ.get("PATH") or "/usr/bin:/bin:/usr/sbin:/sbin"},
            }, f)
        r = subprocess.run(["launchctl", "bootstrap", domain, str(plist)], capture_output=True, text=True)
        if r.returncode != 0:
            say(f"launchctl could not start {plist}: {(r.stderr or '').strip()}", "red")
            return 1
        say(f"`{PROG} watch` now runs in the background and at login. Log: {WATCH_LOG}", "green")
    elif args.action == "uninstall":
        subprocess.run(["launchctl", "bootout", f"{domain}/{LAUNCH_LABEL}"], capture_output=True)
        if plist.exists():
            plist.unlink()
        say(f"Stopped and removed `{PROG} watch` ({plist}).", "green")
    else:
        r = subprocess.run(["launchctl", "print", f"{domain}/{LAUNCH_LABEL}"], capture_output=True, text=True)
        say(f"`{PROG} watch` is {'running' if r.returncode == 0 else 'not running'} ({plist}).",
            "green" if r.returncode == 0 else "yellow")
        if WATCH_LOG.exists():
            for line in WATCH_LOG.read_text(encoding="utf-8", errors="replace").splitlines()[-10:]:
                say(f"  {line}", "gray")
    return 0


# ---------------------------------------------------------------------------
# `claude-relay remote`
# ---------------------------------------------------------------------------
def cmd_remote(args):
    with Locked():
        cfg = load_config()
        hosts = list(cfg.get("remotes") or [])
        if args.action == "add":
            if args.host not in hosts:
                hosts.append(args.host)
        elif args.action == "remove":
            hosts = [h for h in hosts if h != args.host]
        cfg["remotes"] = hosts
        if args.action in ("add", "remove"):
            save_config(cfg)
    if hosts:
        say("SSH hosts restarted by `claude-relay desktop`:", "cyan")
        for h in hosts:
            say(f"  {h}", "white")
    else:
        say(f"No SSH hosts. Add one with: {PROG} remote add <ssh-host>", "yellow")
    return 0


def cmd_remote_install(host):
    """Copy claude-relay to ~/.local/bin on `host` and give it this machine's account names and Claude
    Desktop links, so `claude-relay run` there follows the same accounts. Tokens are not copied."""
    cfg = load_config()
    accounts = [{"name": a["name"], "desktop_account": a.get("desktop_account")} for a in cfg["accounts"]]
    target = f"~/.local/bin/{PROG}"
    steps = (
        (f"mkdir -p ~/.local/bin && cat > {target}.tmp && chmod 755 {target}.tmp && mv {target}.tmp {target}",
         own_script()),
        (f"{target} _import", json.dumps({"accounts": accounts})),
    )
    for command, stdin in steps:
        try:
            r = subprocess.run(ssh_command(host) + [command], input=stdin, capture_output=True, text=True,
                               timeout=120)
        except Exception as e:
            die(f"Could not reach {host}: {e}")
        if r.returncode != 0:
            err = (r.stderr or "").strip().splitlines()
            die(f"Could not install on {host}: {err[-1] if err else f'ssh exited with code {r.returncode}'}")
    say(f"Installed {PROG} {__version__} on {host} ({target}) with {len(accounts)} account(s).", "green")
    if accounts:
        say(f"On {host}, add each account's token once (from `claude setup-token`):", "cyan")
        for a in accounts:
            say(f"  {PROG} accounts add {a['name']}", "white")
    say(f"Then start Claude there with `{PROG} run`, or add to its shell: alias claude='{PROG} run'", "cyan")
    return 0


def internal_import():
    """Run on an SSH host by `remote install`: take the account names and Claude Desktop links from
    standard input. Tokens are added on the host with `accounts add`."""
    data = read_stdin_json()
    names = []
    with Locked():
        cfg = load_config()
        for acc in data.get("accounts") or []:
            name = acc.get("name") if isinstance(acc, dict) else None
            if not (isinstance(name, str) and NAME_RE.match(name)):
                continue
            entry = find_account(cfg, name)
            if entry is None:
                entry = {"name": name, "store": default_store()}
                cfg["accounts"].append(entry)
            link = acc.get("desktop_account")
            if link:
                for other in cfg["accounts"]:
                    if other is not entry and other.get("desktop_account") == link:
                        other.pop("desktop_account")
                entry["desktop_account"] = link
            names.append(name)
        save_config(cfg)
    sys.stdout.write(json.dumps({"accounts": names}) + "\n")
    return 0


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def build_parser():
    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Use several Claude subscriptions as one: automatic account failover for Claude Code "
                    "in the terminal, and session migration for Claude Desktop.",
        epilog=f"Start with: {PROG} accounts add <name>   then   {PROG} run",
    )
    ap.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = ap.add_subparsers(dest="command", metavar="<command>")

    sub.add_parser("run", help="start Claude Code with automatic account failover (claude args follow)",
                   add_help=False)

    acc = sub.add_parser("accounts", help="add, list or remove accounts")
    accsub = acc.add_subparsers(dest="action", metavar="<action>")
    a_add = accsub.add_parser("add", help="store the token for an account")
    a_add.add_argument("name")
    a_add.add_argument("--token-file", metavar="PATH", help="read the token from a file instead of a prompt")
    a_add.add_argument("--store", choices=["keychain", "file"], help="where to keep the token")
    accsub.add_parser("list", help="show accounts, usage and availability")
    a_rm = accsub.add_parser("remove", help="forget an account and delete its token")
    a_rm.add_argument("name")
    a_link = accsub.add_parser("link", help="name a Claude Desktop account (see `desktop --list`)")
    a_link.add_argument("name")
    a_link.add_argument("desktop_account", metavar="DESKTOP_ACCOUNT_ID")

    sub.add_parser("status", help="same as `accounts list`")
    use = sub.add_parser("use", help="make an account the first choice")
    use.add_argument("name")
    reset = sub.add_parser("reset", help="forget recorded usage so accounts are tried again")
    reset.add_argument("name", nargs="?")

    conf = sub.add_parser("config", help="show or change settings")
    conf.add_argument("key", nargs="?")
    conf.add_argument("value", nargs="?")

    rem = sub.add_parser("remote", help="SSH hosts that `desktop` restarts and `watch` keeps in sync")
    rem.add_argument("action", choices=["add", "remove", "list", "install"])
    rem.add_argument("host", nargs="?")

    wat = sub.add_parser("watch", help="follow usage limits and Claude Desktop account switches")
    wat.add_argument("--once", action="store_true", help="run one pass and exit")
    wat.add_argument("--interval", type=int, default=WATCH_INTERVAL, metavar="SECONDS",
                     help=f"seconds between passes (default {WATCH_INTERVAL})")

    svc = sub.add_parser("service", help="run `watch` in the background (launchd agent, macOS)")
    svc.add_argument("action", choices=["install", "uninstall", "status"])

    d = sub.add_parser("desktop", help="move Code-tab sessions to the account Claude Desktop is signed into")
    d.add_argument("--list", action="store_true", help="show account folders and card counts; changes nothing")
    d.add_argument("--dry-run", action="store_true", help="show what would change without writing anything")
    d.add_argument("--existing-cards-only", action="store_true",
                   help="only move sessions created in the Desktop Code tab (skip CLI / VS Code sessions)")
    d.add_argument("--quit", action="store_true", help="quit Claude Desktop first")
    d.add_argument("--reopen", action="store_true", help="reopen Claude Desktop when done")
    d.add_argument("--remote", action="append", metavar="HOST",
                   help="SSH host whose Claude Desktop helpers to restart (default: `remote` list)")
    d.add_argument("--no-remotes", action="store_true", help="do not restart helpers on SSH hosts")
    d.add_argument("--account", metavar="UUID", help="target account id (use with --org)")
    d.add_argument("--org", metavar="UUID", help="target organization id (use with --account)")
    d.add_argument("--cards-dir", metavar="PATH", help=f"card folder (default: {DEFAULT_CARDS})")
    d.add_argument("--projects-dir", metavar="PATH", help=f"transcripts folder (default: {DEFAULT_PROJECTS})")
    d.add_argument("--dest-root", metavar="PATH", help="write cards to this folder instead (testing)")
    d.add_argument("--ignore-running", action="store_true", help="do not stop if Claude Desktop is running")
    d.add_argument("--no-backup", action="store_true", help="skip the backup (testing only)")
    return ap


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "run":
        return cmd_run(argv[1:])
    if argv and argv[0] == "_statusline":
        return internal_statusline()
    if argv and argv[0] == "_hook" and len(argv) > 1:
        return internal_hook(argv[1])
    if argv and argv[0] == "_sync":
        return internal_sync(argv[1] if len(argv) > 1 else "{}")
    if argv and argv[0] == "_import":
        return internal_import()

    ap = build_parser()
    args = ap.parse_args(argv)
    if args.command is None:
        ap.print_help()
        return 0
    if args.command == "accounts":
        if args.action == "add":
            return cmd_accounts_add(args)
        if args.action == "remove":
            return cmd_accounts_remove(args)
        if args.action == "link":
            return cmd_accounts_link(args)
        return cmd_accounts_list(args)
    if args.command == "status":
        return cmd_accounts_list(args)
    if args.command == "use":
        return cmd_use(args)
    if args.command == "reset":
        return cmd_reset(args)
    if args.command == "config":
        return cmd_config(args)
    if args.command == "remote":
        if args.action in ("add", "remove", "install") and not args.host:
            die(f"Usage: {PROG} remote {args.action} <ssh-host>")
        if args.action == "install":
            return cmd_remote_install(args.host)
        return cmd_remote(args)
    if args.command == "desktop":
        say(f"== {PROG} {__version__} · desktop ==", "white")
        return cmd_desktop(args)
    if args.command == "watch":
        return cmd_watch(args)
    if args.command == "service":
        return cmd_service(args)
    ap.print_help()
    return 1


if __name__ == "__main__":
    if sys.version_info < (3, 8):
        sys.stderr.write(f"{PROG} needs Python 3.8 or newer.\n")
        sys.exit(1)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
