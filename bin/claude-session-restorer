#!/usr/bin/env python3
"""Compatibility command: claude-session-restorer is now `claude-relay desktop`."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
relay = os.path.join(here, "claude-relay")
if not os.path.exists(relay):
    sys.stderr.write("claude-session-restorer is now part of claude-relay, but claude-relay was not found "
                     "next to this file. Reinstall: brew install guedesdiogo/tap/claude-relay\n")
    sys.exit(1)
sys.stderr.write("Note: claude-session-restorer is now `claude-relay desktop`.\n")
os.execv(sys.executable, [sys.executable, relay, "desktop"] + sys.argv[1:])
